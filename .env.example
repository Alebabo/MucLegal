# Lokale Serverkonfiguration. Niemals echte Schlüssel committen.
OPENAI_API_KEY=
MUCLEGAL_OPENAI_TENOR_MODEL=gpt-5.6-luna

# Optional: getrennte redaktionelle Grey-Mode-Analyse.
MUCLEGAL_OPENAI_MODEL=gpt-5.6-luna
MUCLEGAL_OPENAI_MAX_INPUT_CHARS=24000
MUCLEGAL_OPENAI_MAX_OUTPUT_TOKENS=900
MUCLEGAL_OPENAI_SAMPLE_INTERVAL_DAYS=7

# Optional: bestehende Anthropic- und Wayback-Funktionen.
# ANTHROPIC_API_KEY=
# WAYBACK_ACCESS_KEY=
# WAYBACK_SECRET_KEY=

# Optional: isolierter lokaler Speicher für eine Demo.
MUCLEGAL_STORE=.muclegal-demo
