{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python build.py",
  "regions": ["fra1"],
  "functions": {"api/index.py": {"maxDuration": 60, "includeFiles": "{data,engine}/**"}},
  "rewrites": [{"source": "/api/scan", "destination": "/api/index"}],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "Referrer-Policy", "value": "no-referrer"},
    {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'"}
  ]}]
}
